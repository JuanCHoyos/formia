{
  "compilerOptions": {
    "allowJs": true,
    "composite": true,
    "declaration": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["DOM", "DOM.Iterable", "DOM.AsyncIterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "sourceMap": true,
    "customConditions": ["@formly/source"],
    "types": ["@total-typescript/ts-reset"]
  }
}