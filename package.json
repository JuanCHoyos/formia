{
  "name": "@formly/source",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @formly/core build && pnpm sst dev --stage dev",
    "dev:secrets": "pnpm sst secret load .env --stage dev",
    "test": "pnpm -r --if-present test",
    "test:unit": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "sst": "catalog:"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.0",
    "vitest": "catalog:"
  },
  "allowScripts": {
    "aws-sdk@2.1693.0": true,
    "esbuild@0.28.2": true
  }
}
