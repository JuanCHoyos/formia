{
  "name": "@formly/backend",
  "version": "1.0.50",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "dev:workspace": "tsc -p tsconfig.json --emitDeclarationOnly --watch",
    "start": "tsx dist/index.js",
    "watch:workspace": "tsc -p tsconfig.json --emitDeclarationOnly --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    "./api": {
      "types": "./dist/api.d.ts"
    }
  },
  "dependencies": {
    "@elysiajs/bearer": "catalog:",
    "@elysiajs/cors": "catalog:",
    "@elysiajs/node": "catalog:",
    "@formly/core": "workspace:*",
    "elysia": "catalog:",
    "elysia-helmet": "catalog:",
    "elysia-rate-limit": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "type": "module",
  "allowScripts": {
    "aws-sdk@2.1693.0": true,
    "esbuild@0.28.2": true
  }
}
